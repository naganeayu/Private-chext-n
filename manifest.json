{
  "manifest_version": 3,
  "name": "ISBN / ISSN NDL 所蔵検索",
  "version": "0.2.3",
  "description": "ページのISBN・ISSNを抽出しNDLサーチSRUで所蔵館名を表示。HTTP 429では数秒後に回数限定で再試行。",
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ISBN / ISSN を調べる",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
